---
import { siteConfig, SocialLinks } from '@/site.config'
import { Icon } from 'astro-icon/components'
const today = new Date()
---

<footer class="basic-container border-foreground/50 dark:border-foreground-dark/50 border-t-2">
	<div class="flex flex-col-reverse justify-between gap-5 py-5 md:flex-row md:items-center">
		<div class="flex">
			<p class="w-full">&copy; {today.getFullYear()} {siteConfig.author}</p>
		</div>
		<div class="flex flex-wrap gap-5">
			{
				SocialLinks.map((link) => (
					<a class="hover:text-primary" href={link.url} target="_blank" rel="noopener noreferrer" title={link.name}>
						<Icon name={`${link.icon}`} size={22} />
					</a>
				))
			}
		</div>
	</div>
</footer>
