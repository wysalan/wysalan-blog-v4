---
import { siteConfig, siteSetting, SocialLinks } from '@/site.config'
import { Icon } from 'astro-icon/components'
import LogoSVG from '../assets/logo.svg'

const today = new Date()
---

<footer class="basic-container border-foreground/50 dark:border-foreground-dark/50 border-t-2">
	<div class="flex flex-col justify-between gap-10 py-10 md:flex-row md:items-center md:pb-10">
		<div class="flex flex-col gap-5 lg:flex-row lg:items-center">
			<a href="/" class="flex max-w-max items-center">
				<LogoSVG height={32} width={32} />
				<h3 class="pl-2 text-2xl font-semibold">{siteSetting.footerTitle || siteConfig.title}</h3>
			</a>
			<div>
				<p class="text-lg opacity-80">{siteSetting.footerDescription || siteConfig.description}</p>
			</div>
		</div>
		<div class="flex flex-wrap gap-5">
			{
				SocialLinks.map((link) => (
					<a class="hover:text-primary" href={link.url} target="_blank" rel="noopener noreferrer" title={link.name}>
						<Icon name={`${link.icon}`} size={24} />
					</a>
				))
			}
		</div>
	</div>
	<div class="flex items-center justify-between pb-10 text-center">
		<p class="w-full text-lg md:text-center">&copy; {today.getFullYear()} {siteConfig.author}</p>
	</div>
</footer>
