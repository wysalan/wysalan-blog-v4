---
import { Icon } from 'astro-icon/components'

const { class: className } = Astro.props
---

<div
	class:list={[
		className,
		'theme-selector relative flex justify-center items-center border border-foreground dark:border-foreground-dark text-foreground dark:text-foreground-dark rounded-full md:opacity-80 *:cursor-pointer',
	]}
>
	<span class="theme-thumb aria-hidden"></span>
	<button
		data-theme="theme-auto"
		aria-label="跟隨系統設定"
		title="跟隨系統設定"
		class="theme-button"
	>
		<Icon name="lucide:monitor" class:list="p-px text-2xl md:text-xl" aria-hidden />
	</button>
	<button
		data-theme="theme-light"
		aria-label="淺色主題"
		title="淺色"
		class="theme-button"
	>
		<Icon name="lucide:sun" class:list="p-px text-2xl md:text-xl" aria-hidden />
	</button>
	<button
		data-theme="theme-dark"
		aria-label="深色主題"
		title="深色"
		class="theme-button"
	>
		<Icon name="lucide:moon" class:list="p-px text-2xl md:text-xl" aria-hidden />
	</button>
</div>

<style>
	@reference "../styles/global.css";

	button.theme-button {
		@apply relative z-10 p-1 rounded-full transition-colors;
	}

	.theme-thumb {
		@apply absolute top-0 left-0 rounded-full bg-foreground/90 dark:bg-foreground-dark/90;
		width: 0;
		height: 100%;
		transition: transform 0.25s ease;
	}

	:global(button.active) {
		@apply text-background dark:text-background-dark;
	}
</style>
