---
import { tagNameSlugify } from '@Utils/tagUtils'
import { Icon } from 'astro-icon/components'

const { tag } = Astro.props
---

<a href=`/tags/${tagNameSlugify(tag.name)}` class="tag-card group">
	<Icon name="material-symbols:tag-rounded" size={24} />
	<span>{tag.name}</span>
	<span class="flex items-center justify-center rounded-md bg-gray-200/75 px-2 dark:bg-gray-200/20">{tag.frequency}</span>
</a>
