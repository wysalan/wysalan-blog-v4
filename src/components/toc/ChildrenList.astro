---
const { headings } = Astro.props
---

{
	(
		<ul class="mt-1 ml-2 space-y-1 pl-2">
			{headings.map((children: typeof headings) => (
				<li>
					<a class="toc-item" href={`#${children.slug}`}>
						{children.text}
					</a>
					{children.children.length > 0 && <Astro.self headings={children.children} />}
				</li>
			))}
		</ul>
	)
}
