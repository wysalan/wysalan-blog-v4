---
import type { MarkdownHeading } from 'astro'
import { Icon } from 'astro-icon/components'
import ChildrenList from './ChildrenList.astro'

interface Props {
	headings: MarkdownHeading[]
}

interface HeadingItem extends MarkdownHeading {
	children: MarkdownHeading[]
}

const { headings } = Astro.props

/**
 * 將原始的一維文章目錄轉換成具有層級關係的多維陣列
 * @param headings 文章目錄
 */
function generateNestedHeading(headings: MarkdownHeading[]) {
	const root = []
	const stack = []
	for (const heading of headings) {
		const item: HeadingItem = { ...heading, children: [] }
		if (stack.length === 0) {
			root.push(item)
			stack.push(item)
			continue
		}
		// 檢查下一個標題的深度是否比上一個還要深，如果深度相同或更淺就回到父層
		if (heading.depth > stack[stack.length - 1].depth) {
			stack[stack.length - 1].children.push(item)
			stack.push(item)
		} else {
			while (stack.length > 0 && heading.depth <= stack[stack.length - 1].depth) {
				stack.pop()
			}
			if (stack.length === 0) {
				root.push(item)
				stack.push(item)
			} else {
				stack[stack.length - 1].children.push(item)
				stack.push(item)
			}
		}
	}
	return root
}

const nestedHeadings = generateNestedHeading(headings)
---

{
	nestedHeadings.length ? (
		<nav class="toc sticky top-35">
			<div class="mb-4 flex items-center">
				<h2 class="font-bold md:text-lg 2xl:text-xl">目錄</h2>
				<div class="group relative ml-1.5 w-12 md:h-6 2xl:h-7">
					<span
						class="pagePercent absolute inset-0 flex items-center justify-center font-mono font-semibold opacity-60 transition-opacity group-hover:opacity-0"
						title="文章瀏覽百分比"
					/>
					<span
						class="back-to-top absolute inset-0 flex cursor-pointer items-center justify-center rounded-lg opacity-0 shadow transition-all group-hover:opacity-100 hover:bg-zinc-200/70 active:shadow-none dark:hover:bg-zinc-200/20"
						title="回到文章頂部"
					>
						<Icon name="lucide:arrow-up-to-line" size={20} class="dark:text-foreground-dark" />
					</span>
				</div>
			</div>
			<ul class="toc-list max-h-[60vh] space-y-1 overflow-y-auto">
				{/* H2 */}
				{nestedHeadings.map((heading) => (
					<li>
						<a class="toc-item" href={`#${heading.slug}`}>
							{heading.text}
						</a>
						{/* H3 and deeper heading */}
						{heading.children.length > 0 && <ChildrenList headings={heading.children} />}
					</li>
				))}
			</ul>
		</nav>
	) : (
		<div />
	)
}

<script>
	document.addEventListener('astro:page-load', () => {
		/** 目錄欄 */
		const tocNav = document.querySelector<HTMLElement>('.toc')

		/** 文章標題元素 */
		const headings = Array.from(
			document.querySelectorAll('.prose h1[id], .prose h2[id], .prose h3[id], .prose h4[id], .prose h5[id], .prose h6[id]')
		)
		
		if (!tocNav || !headings) return
		
		/** 目錄欄連結元素 */
		const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-list li a'))

		/** 使用 Abort Controller 在切換頁面時中止所有事件監聽器 */
		const controller = new AbortController()
		
    let visibleHeadingID: string | null = null
		let activeHeadingID: string | null = null
		let hashFrame: number | null = null

		/** 避免觀察器在初始階段（頁面剛載入）時觀察到錯誤的文章標題並標記錯誤的目錄欄連結元素 */
		let isFirstObserverFire: boolean = true

		/**
		 * 將編碼過的 Hash 字串轉換回原始字串
		 * @param value Hash 字串
		 * @return 解碼正確就返回解碼後的 Hash 字串，若有錯誤則返回原始（被編碼過的）字串
		 */
		function safeDecordURIComponent(value: string) {
			try {
				return decodeURIComponent(value)
			} catch {
				return value
			}
		}

		/**
		 * 取得可用的 Hash 字串
		 * @param link 原始 Hash 字串
		 * @return 經過解碼過的 Hash 字串
		 */
		function getHashId (link: HTMLAnchorElement) {
			return safeDecordURIComponent(link.hash.slice(1))
		}

		/**
		 * 標記目錄欄連結元素
		 * @param id 要被標記的文章標題元素 ID 或 Hash 字串
		 */
		function tocLinkHighlight(id: string) {
			if (id === activeHeadingID) return false
			const activeLink = tocLinks.find((link) => getHashId(link) === id)
			if (!activeLink) return
			activeHeadingID = id
			tocLinks.forEach((link) => link.classList.toggle('toc-highlight', link === activeLink))
			activeLink.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
		}

		/**
		 * 確認標題是否從畫面頂部消失（偵測畫面正在向上或向下捲動）
		 * @param entry 要判斷的標題
		 * @return true 代表標題從畫面頂部消失 (向下捲動)，false 代表標題從畫面頂部出現 (向上捲動)
		 */
		function isEntryExitedFromTop(entry: IntersectionObserverEntry) {
			if (!entry.rootBounds) return
			return entry.rootBounds.bottom - entry.boundingClientRect.bottom > entry.rootBounds.bottom / 2
		}

		/**
		 * 取得標題在文章標題元素（headings）陣列裡的索引值
		 * @param entry 要搜尋的標題
		 * @return 標題位於陣列的索引值
		 */
		function getHeadingIndex(entry: IntersectionObserverEntry) {
			const target = (element: Element) => element === entry.target
			return headings.findIndex(target)
		}

		/** 持續觀察畫面中出現的所有標題元素，並且標記畫面中第一個標題所對應的目錄欄連結元素 */
		const generalObserver = new IntersectionObserver((entries) => {
			if (isFirstObserverFire) {
				isFirstObserverFire = false
				return
			}

			entries.forEach((entry) => {
				// 向上捲動時，標記上一個標題所對應的目錄欄連結元素
				if (!isEntryExitedFromTop(entry) && !entry.isIntersecting) {
					const indexOfHeading = getHeadingIndex(entry)
					if (indexOfHeading === 0) {
						visibleHeadingID = headings[0].id
					} else {
						visibleHeadingID = headings[indexOfHeading - 1].id
					}
				} else if (entry.isIntersecting) {
					visibleHeadingID = entry.target.getAttribute('id')
				}
			})

			if (visibleHeadingID) {
				tocLinkHighlight(visibleHeadingID)
			}
		},
		{
			rootMargin: '-80px 0px -80% 0px',
			threshold: [0],
		})

		/** 在頁面剛載入時，使用此觀察器觀測在畫面中的第一個標題並標記其對應的目錄欄連結元素 */
		const initObserver = new IntersectionObserver((entries, observer) => {
			const firstVisibleEntry = entries
				.filter((entry) => entry.isIntersecting)
				.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0]
			if (!firstVisibleEntry) return

			visibleHeadingID = firstVisibleEntry.target.getAttribute('id')
			if (visibleHeadingID) tocLinkHighlight(visibleHeadingID)

			observer.disconnect()
			headings.forEach((heading) => generalObserver.observe(heading))
		})

		headings.forEach((heading) => {
			initObserver.observe(heading)
		})

		document.addEventListener('astro:before-swap', () => {
			controller.abort()
			initObserver.disconnect()
			generalObserver.disconnect()
			if (hashFrame !== null) cancelAnimationFrame(hashFrame)
		}, { once: true })

		const hash = safeDecordURIComponent(window.location.hash.slice(0))
		if (hash) {
			hashFrame = requestAnimationFrame(() => {
				if (tocLinks.some((link) => getHashId(link) === hash)) {
					tocLinkHighlight(hash)
				}
			})
		}

		const backToTopButton: HTMLElement | null = document.querySelector('.back-to-top')
		const pagePercentElement: HTMLElement | null = document.querySelector('.pagePercent')
		
		function setPagePercent() {
			const pageHeight = document.body.scrollHeight - window.innerHeight
			const scrollPercent = pageHeight > 0 ? Math.min((100 * window.scrollY) / pageHeight, 100) : 0
			if (pagePercentElement) pagePercentElement.textContent = `${Math.ceil(scrollPercent).toString()}%`
		}

		setPagePercent()
		document.addEventListener('scroll', () => setPagePercent(), { signal: controller.signal })
		backToTopButton?.addEventListener('click', () => window.scrollTo(0, 0), { signal: controller.signal })
	})
</script>
