---
import { siteConfig, siteSetting } from '@/site.config'
import { Icon } from 'astro-icon/components'
import { getAllPosts } from '@Utils/postUtils'
import BaseLayout from '@Layouts/BaseLayout.astro'
import PostCard from '@Components/common/PostCard.astro'

const posts = await getAllPosts(4)
---

<BaseLayout>
	<main class="basic-container">
		<header class="flex flex-col justify-center gap-8 pt-35 pb-30">
			<div>
				<p class="mb-6 text-3xl opacity-70">歡迎來到</p>
				<h1 class="text-7xl leading-none font-bold xl:text-8xl">{siteConfig.title}</h1>
			</div>
			<p class="text-2xl leading-normal">{siteSetting.homePageDescription}</p>
		</header>
		<section class="mt-5 mb-25">
			<div class="flex items-center justify-between py-3">
				<h2 class="text-4xl font-semibold">最新文章</h2>
				<a class="btn-secondary" href=`${siteConfig.base}/posts`>
					<span>更多文章</span>
					<Icon size={20} name="lucide:arrow-right" />
				</a>
			</div>
			<div class="mt-6 mb-12 grid items-stretch gap-8 md:grid-cols-2 xl:grid-cols-4">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		</section>
	</main>
</BaseLayout>
